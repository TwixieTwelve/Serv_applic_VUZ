# Шаблон переменных окружения.
# Скопируйте файл в .env и укажите свои значения:  cp .env.example .env
# Файл .env в Git НЕ добавляется (см. .gitignore).

# --- Приложение ---
APP_NAME="Electronic Library API"
APP_ENV=development          # development | test | production
HTTP_PORT=8080

# --- Понадобятся в следующих лабораторных работах ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=library
# DB_USER=library_user
# DB_PASSWORD=
# JWT_SECRET=
